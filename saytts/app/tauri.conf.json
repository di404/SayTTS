{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SayTTS",
  "version": "0.1.0",
  "identifier": "dev.saytts.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SayTTS",
        "width": 460,
        "height": 760,
        "minWidth": 400,
        "minHeight": 560,
        "visible": false,
        "backgroundThrottling": "throttle",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 16, "y": 25 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
